              "openai-api.arkoselabs.com",
              "openaicomproductionae4b.blob.core.windows.net",
              "production-openaicom-storage.azureedge.net",
              "r.bing.com",
              "self.events.data.microsoft.com",
              "services.bingapis.com",
              "sydney.bing.com",
              "www.bing.com"
            ]
          },
          {
            "domain_suffix": [
              "prod.do.dsp.mp.microsoft.com",
              "events.data.microsoft.com",
              "algolia.net",
              "api.microsoftapp.net",
              "auth0.com",
              "bing-shopping.microsoft-falcon.io",
              "chatgpt.com",
              "chatgpt.livekit.cloud",
              "client-api.arkoselabs.com",
              "edgeservices.bing.com",
              "events.statsigapi.net",
              "featuregates.org",
              "host.livekit.cloud",
              "identrust.com",
              "intercom.io",
              "intercomcdn.com",
              "launchdarkly.com",
              "oaistatic.com",
              "oaiusercontent.com",
              "observeit.net",
              "openai.com",
              "openaiapi-site.azureedge.net",
              "openaicom.imgix.net",
              "segment.io",
              "sentry.io",
              "stripe.com",
              "turn.livekit.cloud"
            ]
          },
          { "domain_keyword": ["openaicom-api"] }
        ]
      }
    ],
    "rules": [
      { "inbound": ["dns-in"], "action": "hijack-dns" },
      { "port": 53, "action": "hijack-dns" },
      { "inbound": ["Tailnet"], "action": "reject" },
      { "process_name": ["rex"], "outbound": "direct" },
      { "domain_suffix": ["__TAILNET_DOMAIN__"], "outbound": "Tailnet" },
      { "ip_cidr": ["100.64.0.0/10", "fd7a:115c:a1e0::/48"], "outbound": "Tailnet" },
      { "ip_is_private": true, "outbound": "direct" },
      { "domain_suffix": ["lan", "local"], "outbound": "direct" },
      { "clash_mode": "Direct", "outbound": "direct" },
      { "clash_mode": "Global", "outbound": "Proxy" },
      { "rule_set": ["ai-chatgpt"], "outbound": "🤖 ChatGPT" },
      { "ip_cidr": ["24.199.123.28/32", "64.23.132.171/32"], "outbound": "🤖 ChatGPT" },
      { "rule_set": ["ai-claude"], "outbound": "🤖 Claude" },
      { "rule_set": ["ai-gemini"], "outbound": "🤖 Gemini" },
      { "rule_set": ["ai-copilot"], "outbound": "🤖 Copilot" },
      { "ip_cidr": ["24.199.123.28/32", "64.23.132.171/32"], "outbound": "🤖 Copilot" },
      { "rule_set": ["ai-gemini-platform"], "outbound": "🤖 Gemini" },
      { "rule_set": ["cn-domain", "cn-ip"], "outbound": "direct" }
    ],
    "final": "Proxy"
  }
}
